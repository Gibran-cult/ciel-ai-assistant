# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# Never commit real values.

NGROK_URL = "https://your-subdomain.ngrok-free.dev"
NGROK_USER = "basic-auth-user"
NGROK_PASSWORD = "basic-auth-password"
LANGFLOW_API_KEY = "sk-..."
FLOW_ID = "00000000-0000-0000-0000-000000000000"

# Optional: Chat Input component ID in the flow (default matches v1.1.0)
# CHAT_INPUT_ID = "ChatInput-X8W7I"

# Recommended before going public: contact link (https:// or mailto:) shown
# on the pricing page and on the privacy page for data requests, and the
# operator's name shown on the privacy page (UU 27/2022 PDP).
# CONTACT_URL = "mailto:privacy@example.com"
# OPERATOR_NAME = "Nama pengelola Ciel"

# Optional: memory component IDs in the flow (defaults match flow v1.3.0)
# MEMORY_SEARCH_ID = "CielMemorySearch-BC6pl"
# MEMORY_STORE_ID = "CielMemoryStore-uBmzx"
# TABLE_ANALYST_ID = "CielTableAnalyst-t4bL3"

# Optional: messages per hour (defaults shown). Anonymous visitors also share
# one combined hourly budget so reloading the page does not bypass the limit.
# RATE_LIMIT_PER_HOUR = 20
# RATE_LIMIT_PER_HOUR_LOGIN = 60
# RATE_LIMIT_ANON_TOTAL_PER_HOUR = 150

# Optional: "Data saya" panel (view/delete own memories, delete own server
# chat history). Needs Google login and the Ciel Memory Admin flow.
# MEMORY_ADMIN_FLOW_ID = "00000000-0000-0000-0000-000000000000"
# MEMORY_ADMIN_NODE_ID = "CielMemoryAdmin-adm1n"

# Optional: days server-side chat history is kept, shown on the privacy page.
# Run tools/prune_chat_history.py on the Langflow host with the same value.
# CHAT_RETENTION_DAYS = 30

# Optional: Google login. Long-term memory only works for signed-in users;
# without this block the app runs anonymously with memory disabled.
# Create an OAuth client (Web application) in Google Cloud Console and add
# redirect_uri below as an authorized redirect URI.
# [auth]
# redirect_uri = "https://your-app.streamlit.app/oauth2callback"
# cookie_secret = "a-long-random-string"
# client_id = "xxxx.apps.googleusercontent.com"
# client_secret = "GOCSPX-..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
