# Ciel Agent API, staging (its own Supabase project and its own keys). Copy to deploy/vps/agent-staging.env on the VPS (git-ignored)
# and fill in the values. Names only here: never commit real values.
# Generate the AGENT_*_KEY values with: openssl rand -hex 32

# Supabase (service key; RLS stays on, every query is filtered by owner)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Models: Claude Haiku 5.5, then Gemini as the fallback
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google login for devices: the same OAuth client as the app, with
# https://agent-staging.ciel-ai.web.id/v1/device/callback added as a redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AGENT_GOOGLE_REDIRECT_URI=

# Comma-separated, matched exactly: where a device login may return to, and
# the Origin values allowed on /v1/ws (the extension's chrome-extension://<id>)
AGENT_DEVICE_REDIRECTS=
AGENT_WS_ORIGINS=

# Keys (hex). AGENT_TICKET_KEY_OLD only during a ticket key rotation (SECURITY.md)
AGENT_TICKET_KEY=
AGENT_TICKET_KEY_OLD=
AGENT_CHAIN_KEY=
AGENT_STATE_KEY=

# Clients below this version (x.y.z) are refused with close code 4426
AGENT_MIN_CLIENT_VERSION=

# Switch, daily model cost cap (micro-dollars, all users) and tasks per 30 days
# Staging may set AGENT_ENABLED=1 for the owner's own tests.
AGENT_ENABLED=
AGENT_DAILY_COST_CAP=
AGENT_TASKS_PER_MONTH_FREE=
AGENT_TASKS_PER_MONTH_PRO=
