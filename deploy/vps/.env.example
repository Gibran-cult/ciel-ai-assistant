# Copy to deploy/vps/.env on the VPS (git-ignored) and fill in the values.
# Names only here: never commit real values. Used by docker-compose.yml, by
# tools/render_nginx_gateway.py (--env-file deploy/vps/.env) and by the backup
# scripts. No value may contain $ @ # : / % unless it is in single quotes
# (README.md, step 5). Generate POSTGRES_PASSWORD, LANGFLOW_SECRET_KEY,
# NGROK_PASSWORD and RESTIC_PASSWORD with: openssl rand -hex 32

# Langflow: admin login (the Langflow UI, reached by SSH tunnel) and the key
# that encrypts stored credentials
LANGFLOW_SUPERUSER=
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SECRET_KEY=

# Langflow's Postgres database
POSTGRES_PASSWORD=

# Backups (restic to Cloudflare R2 through its S3 API) and Healthchecks.io pings.
# SUPABASE_DB_URL is the Session pooler URL, in single quotes.
SUPABASE_DB_URL=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HEALTHCHECKS_BACKUP_URL=
HEALTHCHECKS_RESTORE_URL=

# A Langflow API key created in the Langflow UI, for the scripts on the VPS
LANGFLOW_API_KEY=

# The gateway's Basic Auth user and the flow IDs it allows (same names as the
# Streamlit app and the ngrok policy). The flow IDs are the new ones from the
# migration (README.md, step 10).
NGROK_USER=
NGROK_PASSWORD=
FLOW_ID=
MEMORY_ADMIN_FLOW_ID=
RESEARCH_FLOW_ID=
WRITER_FLOW_ID=

# Per IP and minute: flow runs and image uploads through the gateway
GATEWAY_RUN_PER_MINUTE=60

# The laptop's `ollama list` ID of nomic-embed-text-v2-moe:latest. The VPS
# model must have the same ID (README.md, step 8), also after any restore.
OLLAMA_EMBED_MODEL_ID=
