# Copy to deploy/app/.env on the VPS (git-ignored) and fill in the value.
# The app's own secrets are not here: they go in deploy/app/secrets.toml
# (README.md, step 5).

# Hosts Caddy serves, comma-separated, each a DNS-only record pointing at this
# VPS. Staging: next.ciel-ai.web.id
# After the switch: app.ciel-ai.web.id, next.ciel-ai.web.id
CIEL_APP_HOSTS=
