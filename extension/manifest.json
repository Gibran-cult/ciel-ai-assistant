{
  "manifest_version": 3,
  "name": "Ciel Agent",
  "version": "0.1.0",
  "description": "Ciel mengerjakan tugas di browser untukmu, dengan persetujuanmu di setiap langkah yang berisiko.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ciel Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "permissions": ["activeTab", "alarms", "identity", "scripting", "sidePanel", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "stop-agent": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Hentikan Ciel sekarang"
    }
  }
}
